# ==========================================
# AGRILINK - Git ignore
# ==========================================

# Environment variables
.env
.env.*
!.env.example

# Laravel
backend/vendor/
backend/.env
backend/storage/*.key
backend/storage/logs/*
backend/bootstrap/cache/*.php

# Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Temporary files
*.tmp
*.temp